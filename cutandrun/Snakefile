##--------------------------------------------------------------------------------------##
## DeepTools heatmaps (per-sample, peak-centered)
##--------------------------------------------------------------------------------------##

rule macs3_extract_summits:
    """Derive a per-sample summit BED from the MACS3 narrowPeak file.
    Summit position = $2 + $10 (peak offset from start)."""
    input:
        peak = join(OUT_DIR, 'MACS3', '{sample}', '{sample}_peaks.narrowPeak')
    output:
        summits = join(OUT_DIR, 'MACS3', '{sample}', '{sample}.summits.bed')
    shell:
        r'''awk 'BEGIN{{OFS="\t"}} {{s=$2+$10; if (s<0) s=0; print $1,s,s+1,$4,$5,"."}}' {input.peak} '''
        r'''| sort -k1,1 -k2,2n > {output.summits}'''

rule seacr_extract_summits:
    """Derive a per-sample summit BED from the SEACR peak file.
    SEACR col 6 is 'chr:start-end' of the max-signal region; use its midpoint."""
    input:
        bed = join(OUT_DIR, 'SEACR', '{sample}', '{sample}.' + SEACR_MODE + '.bed')
    output:
        summits = join(OUT_DIR, 'SEACR', '{sample}', '{sample}.summits.bed')
    shell:
        r'''awk 'BEGIN{{OFS="\t"}} '''
        r'''{{n=split($6,a,":"); split(a[2],b,"-"); mid=int((b[1]+b[2])/2); '''
        r'''print a[1], mid, mid+1, "peak_"NR, $5, "."}}' {input.bed} '''
        r'''| sort -k1,1 -k2,2n > {output.summits}'''

rule deeptools_computeMatrix_peaks_macs3:
    input:
        bw  = join(OUT_DIR, 'BigWig', '{sample}.bigwig'),
        bed = join(OUT_DIR, 'MACS3', '{sample}', '{sample}.summits.bed'),
    output:
        matrix = join(OUT_DIR, 'DeepTools', 'per_sample', 'peaks_macs3', '{sample}.matrix.gz')
    params:
        bs     = DT_BIN_SIZE,
        before = DT_PEAK_BEFORE,
        after  = DT_PEAK_AFTER,
    threads: 8
    resources:
        mem_mb = 16000
    log:
        join(OUT_DIR, 'Logs', 'DeepTools', 'per_sample', '{sample}.computeMatrix.peaks_macs3.log')
    conda: CONDA_ENV
    shell:
        # Skip empty summit BEDs gracefully (no peaks called).
        'if [ ! -s {input.bed} ]; then'
        '   echo "No MACS3 summits for {wildcards.sample}; emitting empty matrix." > {log};'
        '   : | gzip -nc > {output.matrix};'
        ' else'
        '   computeMatrix reference-point --referencePoint center'
        '     -S {input.bw} -R {input.bed}'
        '     -b {params.before} -a {params.after}'
        '     --binSize {params.bs} --skipZeros -p {threads}'
        '     -o {output.matrix} > {log} 2>&1;'
        ' fi'

rule deeptools_plotHeatmap_peaks_macs3:
