"""
Author: Y. Ahmed-Braimah
--- Snakemake workflow for CUT&RUN / CUT&Tag analysis
    - Bowtie2 alignment to target genome (and optional spike-in)
    - Optional spike-in scaling for bedGraph / bigWig tracks
    - Per-target peak calling with MACS3 and SEACR
    - Pooled IgG (default) or panH3 controls
    - Naive overlap consensus peaks
    - DeepTools heatmaps + MultiQC
"""

import json
import os
from os.path import join

##--------------------------------------------------------------------------------------##
## Config
##--------------------------------------------------------------------------------------##

configfile: 'config.yml'

DNA       = config['DNA']
GTF       = config['GTF']
MITO_ID   = config['MITO_ID']
BLACKLIST = config.get('BLACKLIST', '')
OUT_DIR   = config['OUT_DIR']

USE_SPIKEIN            = bool(config.get('USE_SPIKEIN', False))
SPIKEIN_FASTA          = config.get('SPIKEIN_FASTA', '')
SPIKEIN_SCALE_CONSTANT = int(config.get('SPIKEIN_SCALE_CONSTANT', 10000))

GROUPS          = config['GROUPS']
IGG_SAMPLES     = list(config.get('IGG_SAMPLES', []) or [])
PANH3_SAMPLES   = list(config.get('PANH3_SAMPLES', []) or [])
SAMPLE_CONTROLS = dict(config.get('SAMPLE_CONTROLS', {}) or {})

CUTADAPT_ADAPTERS = config['CUTADAPT_ADAPTERS']
CUTADAPT_EXTRA    = config['CUTADAPT_EXTRA']

BT2_TARGET_PARAMS  = config['BOWTIE2_TARGET_PARAMS']
BT2_SPIKEIN_PARAMS = config['BOWTIE2_SPIKEIN_PARAMS']

MIN_MAPQ            = int(config.get('MIN_MAPQ', 30))
REMOVE_DUPS_TARGETS = bool(config.get('REMOVE_DUPS_TARGETS', False))

MACS3_GSIZE  = config['MACS3_GSIZE']
MACS3_QVALUE = config['MACS3_QVALUE']
MACS3_EXTRA  = config['MACS3_EXTRA']

SEACR_THRESHOLD = config['SEACR_THRESHOLD']
SEACR_MODE      = config['SEACR_MODE']
SEACR_NORM      = config['SEACR_NORM']

DT_BIN_SIZE       = int(config['DT_BIN_SIZE'])
DT_REGION_BODY    = int(config['DT_REGION_BODY'])
DT_BEFORE_REGION  = int(config['DT_BEFORE_REGION'])
DT_AFTER_REGION   = int(config['DT_AFTER_REGION'])

DT_PEAK_BEFORE          = int(config.get('DT_PEAK_BEFORE', 3000))
DT_PEAK_AFTER           = int(config.get('DT_PEAK_AFTER', 3000))
DT_QC_BIN_SIZE          = int(config.get('DT_QC_BIN_SIZE', 10000))
DT_QC_CORR_METHOD       = config.get('DT_QC_CORR_METHOD', 'spearman')
DT_FINGERPRINT_SAMPLES  = int(config.get('DT_FINGERPRINT_SAMPLES', 500000))
DT_FINGERPRINT_BINSIZE  = int(config.get('DT_FINGERPRINT_BINSIZE', 500))

DIFFBIND_PEAKCALLER     = config.get('DIFFBIND_PEAKCALLER', 'macs3').lower()
DIFFBIND_MIN_OVERLAP    = int(config.get('DIFFBIND_MIN_OVERLAP', 2))
DIFFBIND_FDR_THRESHOLD  = float(config.get('DIFFBIND_FDR_THRESHOLD', 0.05))
if DIFFBIND_PEAKCALLER not in ('macs3', 'seacr'):
    raise ValueError(f"DIFFBIND_PEAKCALLER must be 'macs3' or 'seacr' (got '{DIFFBIND_PEAKCALLER}')")
DIFFBIND_CONDA_ENV = 'envs/diffbind.yml'

FILES = json.load(open(config['PE_SAMPLES_JSON']))


TARGET_SAMPLES  = sorted({s for reps in GROUPS.values() for s in reps})
CONTROL_SAMPLES = sorted(set(IGG_SAMPLES) | set(PANH3_SAMPLES))
ALL_SAMPLES     = sorted(set(TARGET_SAMPLES) | set(CONTROL_SAMPLES))

# ---- Validate config ----
for s in ALL_SAMPLES:
    if s not in FILES:
        raise ValueError(f"Sample '{s}' referenced in config but missing from PE_SAMPLES_JSON")
for grp, ct in SAMPLE_CONTROLS.items():
    if ct not in ('IgG', 'panH3'):
        raise ValueError(f"SAMPLE_CONTROLS[{grp}] = '{ct}' invalid; must be 'IgG' or 'panH3'")
    if grp not in GROUPS:
        raise ValueError(f"SAMPLE_CONTROLS references unknown group '{grp}'")

def control_type_for(group):
    return SAMPLE_CONTROLS.get(group, 'IgG')

def control_samples_for(ctrl_type):
    return IGG_SAMPLES if ctrl_type == 'IgG' else PANH3_SAMPLES

# Distinct control types actually used (so we only pool what we need)
USED_CONTROL_TYPES = sorted({control_type_for(g) for g in GROUPS} &
                            {'IgG', 'panH3'})
# Drop control types whose sample list is empty
USED_CONTROL_TYPES = [ct for ct in USED_CONTROL_TYPES if control_samples_for(ct)]

# Map target group -> assigned control pool BAM / bedGraph (or '' if none)
def control_bam_for(group):
    ct = control_type_for(group)
    if not control_samples_for(ct):
        return ''
    return join(OUT_DIR, 'pooled_controls', f'{ct}.pooled.bam')

def control_bedgraph_for(group):
    ct = control_type_for(group)
    if not control_samples_for(ct):
        return ''
    return join(OUT_DIR, 'pooled_controls', f'{ct}.pooled.bedgraph')

def group_of(sample):
    """Return the target group that owns this sample (KeyError if not a target)."""
    return next(g for g, reps in GROUPS.items() if sample in reps)

os.makedirs(OUT_DIR, exist_ok=True)

CONDA_ENV = 'envs/cutandrun_yablab.yml'

##--------------------------------------------------------------------------------------##
## Targets
##--------------------------------------------------------------------------------------##

rule all:
    input:
        join(OUT_DIR, 'MultiQC', 'multiqc_report.html'),
        # MACS3 + SEACR per-replicate peak calls
        expand(join(OUT_DIR, 'MACS3', '{sample}', '{sample}_peaks.narrowPeak'),
               sample=TARGET_SAMPLES),
        expand(join(OUT_DIR, 'SEACR', '{sample}', '{sample}.' + SEACR_MODE + '.bed'),
               sample=TARGET_SAMPLES),
        # Consensus (naive-overlap) peaks per target group
        expand(join(OUT_DIR, 'MACS3', '{group}', 'finalPeakList.narrowPeak.gz'),
               group=list(GROUPS.keys())),
        expand(join(OUT_DIR, 'SEACR', '{group}', 'finalPeakList.bed.gz'),
               group=list(GROUPS.keys())),
        # BigWigs (for IGV / heatmaps)
        expand(join(OUT_DIR, 'BigWig', '{sample}.bigwig'), sample=ALL_SAMPLES),
        # DeepTools per-sample gene-body heatmaps
        expand(join(OUT_DIR, 'DeepTools', 'per_sample', 'genes', '{sample}.heatmap.png'),
               sample=TARGET_SAMPLES),
        # DeepTools per-sample peak-centered heatmaps (MACS3 + SEACR)
        expand(join(OUT_DIR, 'DeepTools', 'per_sample', 'peaks_macs3', '{sample}.heatmap.png'),
               sample=TARGET_SAMPLES),
        expand(join(OUT_DIR, 'DeepTools', 'per_sample', 'peaks_seacr', '{sample}.heatmap.png'),
               sample=TARGET_SAMPLES),
        # DeepTools QC suite
        join(OUT_DIR, 'DeepTools', 'qc', 'correlation.heatmap.png'),
        join(OUT_DIR, 'DeepTools', 'qc', 'pca.png'),
        expand(join(OUT_DIR, 'DeepTools', 'qc', 'fingerprint', '{sample}.png'),
               sample=ALL_SAMPLES),
        # DiffBind: samplesheet + executed notebook + analysis RDS
        join(OUT_DIR, 'DiffBind', 'samplesheet.csv'),
        join(OUT_DIR, 'DiffBind', 'diffbind_analysis.executed.ipynb'),
        join(OUT_DIR, 'DiffBind', 'dba_analysis.rds'),

##--------------------------------------------------------------------------------------##
## QC
##--------------------------------------------------------------------------------------##

rule fastqc:
    input:
        r1 = lambda wc: FILES[wc.sample]['R1'],
        r2 = lambda wc: FILES[wc.sample]['R2'],
    output:
        r1 = join(OUT_DIR, 'fastQC', '{sample}.R1_fastqc.html'),
        r2 = join(OUT_DIR, 'fastQC', '{sample}.R2_fastqc.html'),
    log:
        join(OUT_DIR, 'Logs', 'fastQC', '{sample}.fastQC.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'fastQC', '{sample}.benchmark.tsv')
    message:
        '--- FastQC on sample "{wildcards.sample}"'
    threads: 4
    conda: CONDA_ENV
    shell:
        'fastqc -o ' + join(OUT_DIR, 'fastQC') +
        ' -t {threads} -q {input.r1} {input.r2} > {log} 2>&1'

##--------------------------------------------------------------------------------------##

rule cutadapt:
    input:
        lambda wc: FILES[wc.sample]['R1'],
        lambda wc: FILES[wc.sample]['R2'],
    output:
        fastq1 = join(OUT_DIR, 'trimmed_reads', '{sample}.1.fq.gz'),
        fastq2 = join(OUT_DIR, 'trimmed_reads', '{sample}.2.fq.gz'),
        qc     = join(OUT_DIR, 'trimmed_reads', '{sample}.qc.txt'),
    params:
        adapters = CUTADAPT_ADAPTERS,
        extra    = CUTADAPT_EXTRA,
    log:
        join(OUT_DIR, 'Logs', 'cutadapt', '{sample}.cutadapt.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'cutadapt', '{sample}.benchmark.tsv')
    message:
        '--- Trimming adapters for sample "{wildcards.sample}"'
    threads: 4
    resources:
        mem_mb = 8000
    wrapper:
        "v3.10.2/bio/cutadapt/pe"

