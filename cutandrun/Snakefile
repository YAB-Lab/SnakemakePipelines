rule bowtie2_build_target:
    output:
        reference = join(OUT_DIR, 'reference', 'target', 'genome.fasta'),
        idx       = join(OUT_DIR, 'reference', 'target', 'genome.rev.2.bt2'),
    log:
        join(OUT_DIR, 'Logs', 'Bowtie2', 'target.bowtie2-build.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'Bowtie2', 'target.bt2-build.benchmark.tsv')
    threads: 8
    conda: CONDA_ENV
    shell:
        'cp ' + DNA + ' {output.reference}'
        ' && bowtie2-build --threads {threads} {output.reference} ' +
        join(OUT_DIR, 'reference', 'target', 'genome') + ' > {log} 2>&1'

rule bowtie2_build_spikein:
    output:
        reference = join(OUT_DIR, 'reference', 'spikein', 'genome.fasta'),
        idx       = join(OUT_DIR, 'reference', 'spikein', 'genome.rev.2.bt2'),
    log:
        join(OUT_DIR, 'Logs', 'Bowtie2', 'spikein.bowtie2-build.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'Bowtie2', 'spikein.bt2-build.benchmark.tsv')
    threads: 8
    conda: CONDA_ENV
    shell:
        'cp ' + SPIKEIN_FASTA + ' {output.reference}'
        ' && bowtie2-build --threads {threads} {output.reference} ' +
        join(OUT_DIR, 'reference', 'spikein', 'genome') + ' > {log} 2>&1'

rule compute_chrom_sizes:
    input:
        reference = join(OUT_DIR, 'reference', 'target', 'genome.fasta')
    output:
        cs  = join(OUT_DIR, 'reference', 'target', 'chrom_sizes.txt'),
        fai = join(OUT_DIR, 'reference', 'target', 'genome.fasta.fai'),
    conda: CONDA_ENV
    shell:
        'samtools faidx {input.reference}'
        ' && cut -f1,2 {output.fai} > {output.cs}'

rule extract_gene_bodies:
    """Extract gene bodies as BED. If the GTF lacks 'gene' features in column 3,
    reconstruct them from transcript/exon hierarchy with AGAT first. AGAT's
    side-effects (agat_config.yaml, .agat.log) are confined to agat_workdir/
    under the reference output so the working directory stays clean."""
    input:
        gtf = GTF
    output:
        bed = join(OUT_DIR, 'reference', 'target', 'genes.bed')
    params:
        gtf_fixed = join(OUT_DIR, 'reference', 'target', 'genes.fixed.gtf'),
        agat_wd   = join(OUT_DIR, 'reference', 'target', 'agat_workdir'),
    log:
        join(OUT_DIR, 'Logs', 'reference', 'extract_gene_bodies.log')
    conda: CONDA_ENV
    shell:
        r'''
        set -euo pipefail
        mkdir -p $(dirname {log}) {params.agat_wd}
        has_gene=$(awk -F'\t' 'BEGIN{{f=0}} /^#/{{next}} $3=="gene"{{f=1; exit}} END{{print f}}' {input.gtf})
        if [ "$has_gene" = "1" ]; then
            echo "GTF already contains 'gene' features; skipping AGAT." > {log}
            gtf={input.gtf}
        else
            echo "GTF lacks 'gene' features; reconstructing with AGAT..." > {log}
            in_gtf=$(readlink -f {input.gtf})
            out_gtf=$(readlink -f {params.gtf_fixed})
            log_abs=$(readlink -f {log})
            ( cd {params.agat_wd} && \
              agat_convert_sp_gxf2gxf.pl -g "$in_gtf" -o "$out_gtf" >> "$log_abs" 2>&1 )
            gtf={params.gtf_fixed}
        fi
        awk 'BEGIN{{OFS="\t"}} $3=="gene" {{print $1,$4-1,$5,".",".",$7}}' "$gtf" \
            | sort -k1,1V -k2,2n > {output.bed}
        '''

##--------------------------------------------------------------------------------------##
## Alignment
##--------------------------------------------------------------------------------------##

rule bowtie2_target:
    input:
        r1  = join(OUT_DIR, 'trimmed_reads', '{sample}.1.fq.gz'),
        r2  = join(OUT_DIR, 'trimmed_reads', '{sample}.2.fq.gz'),
        idx = join(OUT_DIR, 'reference', 'target', 'genome.rev.2.bt2'),
    output:
        cbam = join(OUT_DIR, 'Bowtie2', 'target', '{sample}.csorted.bam'),
        nbam = join(OUT_DIR, 'Bowtie2', 'target', '{sample}.nsorted.bam'),
    params:
        bt2 = BT2_TARGET_PARAMS,
    log:
        bt2 = join(OUT_DIR, 'Logs', 'Bowtie2', '{sample}.target.bowtie2.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'Bowtie2', '{sample}.target.benchmark.tsv')
    message:
        '--- Aligning "{wildcards.sample}" to target genome'
    threads: 8
    resources:
        mem_mb = 16000
    conda: CONDA_ENV
    shell:
        '(bowtie2 {params.bt2}'
        ' --mm -p {threads}'
        ' --rg-id i{wildcards.sample} --rg SM:{wildcards.sample}'
        ' -x ' + join(OUT_DIR, 'reference', 'target', 'genome') +
        ' -1 {input.r1} -2 {input.r2})'
        ' 2> {log.bt2}'
        ' | samtools sort -n -@ {threads} -o {output.nbam} -'
        ' && samtools sort --threads {threads} -o {output.cbam} {output.nbam}'
        ' && samtools index -@ 4 {output.cbam}'

rule bowtie2_spikein:
    input:
        r1  = join(OUT_DIR, 'trimmed_reads', '{sample}.1.fq.gz'),
        r2  = join(OUT_DIR, 'trimmed_reads', '{sample}.2.fq.gz'),
        idx = join(OUT_DIR, 'reference', 'spikein', 'genome.rev.2.bt2'),
    output:
        bam   = join(OUT_DIR, 'Bowtie2', 'spikein', '{sample}.bam'),
        stats = join(OUT_DIR, 'Bowtie2', 'spikein', '{sample}.flagstat'),
    params:
        bt2 = BT2_SPIKEIN_PARAMS,
    log:
        bt2 = join(OUT_DIR, 'Logs', 'Bowtie2', '{sample}.spikein.bowtie2.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'Bowtie2', '{sample}.spikein.benchmark.tsv')
    message:
        '--- Aligning "{wildcards.sample}" to spike-in genome'
    threads: 8
    resources:
        mem_mb = 8000
    conda: CONDA_ENV
    shell:
        '(bowtie2 {params.bt2} --mm -p {threads}'
        ' -x ' + join(OUT_DIR, 'reference', 'spikein', 'genome') +
        ' -1 {input.r1} -2 {input.r2})'
        ' 2> {log.bt2}'
        ' | samtools sort -@ {threads} -o {output.bam} -'
        ' && samtools index -@ 4 {output.bam}'
        ' && samtools flagstat -@ 4 {output.bam} > {output.stats}'

##--------------------------------------------------------------------------------------##
## Filter, mark/remove duplicates
##--------------------------------------------------------------------------------------##

rule qualimap:
    input:
        bam = join(OUT_DIR, 'Bowtie2', 'target', '{sample}.csorted.bam'),
    output:
        bamqc = join(OUT_DIR, 'Bowtie2', 'target', '{sample}', 'bamqc', 'qualimapReport.html')
    log:
        join(OUT_DIR, 'Logs', 'Qualimap', '{sample}.bamqc.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'Qualimap', '{sample}.benchmark.tsv')
    message:
        '--- Qualimap BAMQC on "{wildcards.sample}"'
    threads: 8
    resources:
        mem_mb = 32000
    conda: CONDA_ENV
    shell:
        'qualimap bamqc -bam {input.bam} -c'
        ' -outdir ' + join(OUT_DIR, 'Bowtie2', 'target', '{wildcards.sample}', 'bamqc') +
        ' --java-mem-size=32G -nt {threads} > {log} 2>&1'

def _remove_dups_flag(wildcards):
    """REMOVE_DUPLICATES=true for controls and (optionally) targets."""
    if wildcards.sample in CONTROL_SAMPLES:
        return 'true'
    return 'true' if REMOVE_DUPS_TARGETS else 'false'

rule mark_duplicates:
    input:
        cbam = join(OUT_DIR, 'Bowtie2', 'target', '{sample}.csorted.bam')
    output:
        fbam     = join(OUT_DIR, 'Bowtie2', 'target', '{sample}.filt.bam'),
        bai      = join(OUT_DIR, 'Bowtie2', 'target', '{sample}.filt.bam.bai'),
        metrics  = join(OUT_DIR, 'Bowtie2', 'target', '{sample}.dupmark.metrics'),
        idxstats = join(OUT_DIR, 'Bowtie2', 'target', '{sample}.idxstats'),
        flagstat = join(OUT_DIR, 'Bowtie2', 'target', '{sample}.flagstat'),
    params:
        min_mapq    = MIN_MAPQ,
        remove_dups = _remove_dups_flag,
        blacklist   = BLACKLIST,
    threads: 8
    resources:
        mem_mb = 16000
    log:
        join(OUT_DIR, 'Logs', 'Bowtie2', '{sample}.dupmark.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'Bowtie2', '{sample}.dupmark.benchmark.tsv')
    message:
        '--- Filtering + Picard MarkDuplicates on "{wildcards.sample}" (remove_dups={params.remove_dups})'
    conda: CONDA_ENV
    shell:
        # 1) MAPQ + proper-pair filter + name-sort + fixmate
        'samtools view -F 1804 -f 2 -q {params.min_mapq} -u {input.cbam}'
        ' | samtools sort -@ {threads} -n -o {wildcards.sample}.tmp.namesort.bam -'
        ' && samtools fixmate -r {wildcards.sample}.tmp.namesort.bam {wildcards.sample}.tmp.fixmate.bam'
        ' && samtools view -F 1804 -f 2 -u {wildcards.sample}.tmp.fixmate.bam'
        ' | samtools sort -@ {threads} -o {wildcards.sample}.tmp.csorted.bam -'
        # 2) Picard MarkDuplicates
        ' && picard MarkDuplicates'
        '   I={wildcards.sample}.tmp.csorted.bam'
        '   O={wildcards.sample}.tmp.dupmark.bam'
        '   M={output.metrics}'
        '   REMOVE_DUPLICATES={params.remove_dups}'
        '   VALIDATION_STRINGENCY=LENIENT ASSUME_SORTED=true > {log} 2>&1'
        # 3) Optional blacklist subtraction
        + (' && bedtools intersect -v -abam {wildcards.sample}.tmp.dupmark.bam -b ' + BLACKLIST +
           ' > {output.fbam}' if BLACKLIST else
           ' && mv {wildcards.sample}.tmp.dupmark.bam {output.fbam}') +
        ' && samtools index -@ 4 {output.fbam}'
        ' && samtools idxstats {output.fbam} > {output.idxstats}'
        ' && samtools flagstat -@ 4 {output.fbam} > {output.flagstat}'
        ' && rm -f {wildcards.sample}.tmp.namesort.bam'
        '          {wildcards.sample}.tmp.fixmate.bam'
        '          {wildcards.sample}.tmp.csorted.bam'
        '          {wildcards.sample}.tmp.dupmark.bam'

##--------------------------------------------------------------------------------------##
## Spike-in scale factors
##--------------------------------------------------------------------------------------##

rule spikein_scale_factor:
    input:
        flagstat = join(OUT_DIR, 'Bowtie2', 'spikein', '{sample}.flagstat')
    output:
        sf = join(OUT_DIR, 'Bowtie2', 'spikein', '{sample}.scalefactor.txt')
    params:
        c = SPIKEIN_SCALE_CONSTANT
    shell:
        # Mapped reads = line 7 ("mapped") field 1 in samtools flagstat output.
        r'''mapped=$(grep -m1 'primary mapped' {input.flagstat} | awk '{{print $1}}'); '''
        r'''if [ -z "$mapped" ]; then mapped=$(awk 'NR==5 {{print $1}}' {input.flagstat}); fi; '''
        r'''if [ "$mapped" -gt 0 ]; then awk -v c={params.c} -v m=$mapped 'BEGIN{{printf "%.6f\n", c/m}}' > {output.sf}; '''
        r'''else echo "1.0" > {output.sf}; fi'''

##--------------------------------------------------------------------------------------##
## BedGraph / BigWig (per sample)
##--------------------------------------------------------------------------------------##

def _bedgraph_inputs(wildcards):
    d = {
        'bam': join(OUT_DIR, 'Bowtie2', 'target', f'{wildcards.sample}.filt.bam'),
        'cs':  join(OUT_DIR, 'reference', 'target', 'chrom_sizes.txt'),
    }
    if USE_SPIKEIN:
        d['sf'] = join(OUT_DIR, 'Bowtie2', 'spikein', f'{wildcards.sample}.scalefactor.txt')
    return d

rule bam_to_bedgraph:
    input:
        unpack(_bedgraph_inputs)
    output:
        bg = join(OUT_DIR, 'BedGraph', '{sample}.bedgraph')
    threads: 4
    resources:
        mem_mb = 8000
    log:
        join(OUT_DIR, 'Logs', 'BedGraph', '{sample}.bedgraph.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'BedGraph', '{sample}.benchmark.tsv')
    message:
        '--- BAM->bedGraph for "{wildcards.sample}"' +
        (' (spike-in scaled)' if USE_SPIKEIN else ' (CPM)')
    conda: CONDA_ENV
    shell:
        # paired-end fragments only (-pc), sorted output. Scale by spike-in or CPM (per fragment).
        ('scale=$(cat {input.sf})' if USE_SPIKEIN else
         # Count fragments: read1 of properly-paired alignments, excluding dup/secondary/unmapped.
         'reads=$(samtools view -c -f 66 -F 1804 {input.bam}); '
         r'''scale=$(awk -v r=$reads 'BEGIN{{if(r>0) printf "%.6f\n", 1000000.0/r; else print "1.0"}}')''') +
        ' && bedtools genomecov -bg -pc -scale $scale -ibam {input.bam}'
        ' | sort -k1,1 -k2,2n > {output.bg} 2> {log}'

rule bedgraph_to_bigwig:
    input:
        bg = join(OUT_DIR, 'BedGraph', '{sample}.bedgraph'),
        cs = join(OUT_DIR, 'reference', 'target', 'chrom_sizes.txt'),
    output:
        bw = join(OUT_DIR, 'BigWig', '{sample}.bigwig')
    log:
        join(OUT_DIR, 'Logs', 'BigWig', '{sample}.bigwig.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'BigWig', '{sample}.benchmark.tsv')
    message:
        '--- bedGraph->bigWig for "{wildcards.sample}"'
    conda: CONDA_ENV
    shell:
        'bedClip {input.bg} {input.cs} {output.bw}.tmp.bg'
        ' && sort -k1,1 -k2,2n {output.bw}.tmp.bg > {output.bw}.tmp.sorted.bg'
        ' && bedGraphToBigWig {output.bw}.tmp.sorted.bg {input.cs} {output.bw} 2> {log}'
        ' && rm -f {output.bw}.tmp.bg {output.bw}.tmp.sorted.bg'

##--------------------------------------------------------------------------------------##
## Pooled controls (merged across replicates of a control type)
##--------------------------------------------------------------------------------------##

rule pool_control_bam:
    input:
        bams = lambda wc: expand(join(OUT_DIR, 'Bowtie2', 'target', '{s}.filt.bam'),
                                 s=control_samples_for(wc.ctrl_type))
    output:
        bam = join(OUT_DIR, 'pooled_controls', '{ctrl_type}.pooled.bam'),
        bai = join(OUT_DIR, 'pooled_controls', '{ctrl_type}.pooled.bam.bai'),
    threads: 4
    resources:
        mem_mb = 8000
    message:
        '--- Pooling control BAMs for type "{wildcards.ctrl_type}"'
    conda: CONDA_ENV
    shell:
        'samtools merge -@ {threads} -f {output.bam} {input.bams}'
        ' && samtools index -@ {threads} {output.bam}'

rule pool_control_bedgraph:
    input:
        bgs = lambda wc: expand(join(OUT_DIR, 'BedGraph', '{s}.bedgraph'),
                                s=control_samples_for(wc.ctrl_type))
    output:
        bg = join(OUT_DIR, 'pooled_controls', '{ctrl_type}.pooled.bedgraph')
    message:
        '--- Pooling control bedGraphs for type "{wildcards.ctrl_type}" (mean across reps)'
    conda: CONDA_ENV
    shell:
        # Union of all positions, then mean over reps (-na 0 to count missing as 0).
        'bedtools unionbedg -i {input.bgs}'
        ' | awk \'BEGIN{{OFS="\\t"}}{{n=NF-3; s=0; for(i=4;i<=NF;i++) s+=$i; print $1,$2,$3,s/n}}\''
        ' | sort -k1,1 -k2,2n > {output.bg}'

##--------------------------------------------------------------------------------------##
## Peak calling — MACS3 (per replicate)
##--------------------------------------------------------------------------------------##

def _macs3_inputs(wildcards):
    grp  = group_of(wildcards.sample)
    cbam = control_bam_for(grp)
    d = {'bam': join(OUT_DIR, 'Bowtie2', 'target', f'{wildcards.sample}.filt.bam')}
    if cbam:
        d['ctrl'] = cbam
    return d

def _macs3_ctrl_arg(wildcards):
    cbam = control_bam_for(group_of(wildcards.sample))
    return ('-c ' + cbam) if cbam else ''

rule macs3_callpeak:
    input:
        unpack(_macs3_inputs)
    output:
        peak    = join(OUT_DIR, 'MACS3', '{sample}', '{sample}_peaks.narrowPeak'),
        peak_gz = join(OUT_DIR, 'MACS3', '{sample}', '{sample}.narrowPeak.gz'),
    params:
        gsize    = MACS3_GSIZE,
        q        = MACS3_QVALUE,
        extra    = MACS3_EXTRA,
        outdir   = lambda wc: join(OUT_DIR, 'MACS3', wc.sample),
        ctrl_arg = _macs3_ctrl_arg,
    threads: 1
    resources:
        mem_mb = 16000
    log:
        join(OUT_DIR, 'Logs', 'MACS3', '{sample}.macs3.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'MACS3', '{sample}.benchmark.tsv')
    message:
        '--- MACS3 callpeak on "{wildcards.sample}"'
    conda: CONDA_ENV
    shell:
        'macs3 callpeak -t {input.bam} {params.ctrl_arg}'
        ' -f BAMPE -g {params.gsize} -q {params.q}'
        ' --outdir {params.outdir} -n {wildcards.sample}'
        ' {params.extra} > {log} 2>&1'
        ' && sort -k 8gr,8gr {output.peak}'
        ' | awk \'BEGIN{{OFS="\\t"}}{{$4="Peak_"NR; if ($2<0) $2=0; if ($3<0) $3=0; print $0}}\''
        ' | gzip -nc > {output.peak_gz}'

##--------------------------------------------------------------------------------------##
## Peak calling — SEACR (per replicate)
##--------------------------------------------------------------------------------------##

def _seacr_inputs(wildcards):
    grp = group_of(wildcards.sample)
    cbg = control_bedgraph_for(grp)
    d = {'bg': join(OUT_DIR, 'BedGraph', f'{wildcards.sample}.bedgraph')}
    if cbg:
        d['ctrl'] = cbg
    return d

def _seacr_ctrl_or_thresh(wildcards):
    cbg = control_bedgraph_for(group_of(wildcards.sample))
    return cbg if cbg else str(SEACR_THRESHOLD)

rule seacr_callpeak:
    input:
        unpack(_seacr_inputs)
    output:
        bed    = join(OUT_DIR, 'SEACR', '{sample}', '{sample}.' + SEACR_MODE + '.bed'),
        bed_gz = join(OUT_DIR, 'SEACR', '{sample}', '{sample}.bed.gz'),
    params:
        mode   = SEACR_MODE,
        norm   = SEACR_NORM,
        prefix = lambda wc: join(OUT_DIR, 'SEACR', wc.sample, wc.sample),
        # bedGraph if a control pool exists, otherwise numeric threshold.
        ctrl_or_thresh = _seacr_ctrl_or_thresh,
    threads: 1
    resources:
        mem_mb = 8000
    log:
        join(OUT_DIR, 'Logs', 'SEACR', '{sample}.seacr.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'SEACR', '{sample}.benchmark.tsv')
    message:
        '--- SEACR callpeak on "{wildcards.sample}" (mode={params.mode}, norm={params.norm})'
    conda: CONDA_ENV
    shell:
        'mkdir -p ' + join(OUT_DIR, 'SEACR', '{wildcards.sample}') +
        ' && SEACR_1.3.sh {input.bg} {params.ctrl_or_thresh} {params.norm} {params.mode}'
        ' {params.prefix} > {log} 2>&1'
        ' && gzip -nc {output.bed} > {output.bed_gz}'

##--------------------------------------------------------------------------------------##
## Consensus (naive overlap) per target group
##--------------------------------------------------------------------------------------##

def _naive_overlap_cmd(beds, output_gz, n_fields=10):
    """Chained bedtools intersect to keep peaks reproducible across replicates.

    A peak is kept if >=50% of either side is in the overlap. n_fields is the
    width of each input BED (10 for MACS3 narrowPeak, 6 for SEACR).
    """
    b_start = n_fields + 2      # column index of B.start in 1-based awk
    b_end   = n_fields + 3      # column index of B.end
    ov      = 2 * n_fields + 1  # column index of overlap (last column from -wo)
    awk = (
        f"awk 'BEGIN{{FS=\"\\t\";OFS=\"\\t\"}}"
        f"{{s1=$3-$2; s2=${b_end}-${b_start}; "
        f"if ((${ov}/s1 >= 0.5) || (${ov}/s2 >= 0.5)) print $0}}'"
    )
    cut = f"cut -f 1-{n_fields}"

    if len(beds) == 1:
        return f"zcat {beds[0]} | sort -k1,1 -k2,2n | uniq | gzip -nc > {output_gz}"

    cmd = (f"intersectBed -wo -a {beds[0]} -b {beds[1]}"
           f" | {awk} | {cut} | sort -k1,1 -k2,2n | uniq")
    for b in beds[2:]:
        cmd += (f" | intersectBed -wo -a stdin -b {b}"
                f" | {awk} | {cut} | sort -k1,1 -k2,2n | uniq")
    cmd += f" | gzip -nc > {output_gz}"
    return cmd

rule consensus_peaks_macs3:
    input:
        peaks = lambda wc: expand(join(OUT_DIR, 'MACS3', '{s}', '{s}.narrowPeak.gz'),
                                  s=GROUPS[wc.group])
    output:
        final = join(OUT_DIR, 'MACS3', '{group}', 'finalPeakList.narrowPeak.gz')
    params:
        cmd = lambda wc: _naive_overlap_cmd(
            [join(OUT_DIR, 'MACS3', s, f'{s}.narrowPeak.gz') for s in GROUPS[wc.group]],
            join(OUT_DIR, 'MACS3', wc.group, 'finalPeakList.narrowPeak.gz'))
    threads: 4
    resources:
        mem_mb = 8000
    log:
        join(OUT_DIR, 'Logs', 'MACS3', '{group}.naiveOverlap.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'MACS3', '{group}.naiveOverlap.tsv')
    message:
        '--- MACS3 naive-overlap consensus for group "{wildcards.group}"'
    conda: CONDA_ENV
    shell:
        'mkdir -p ' + join(OUT_DIR, 'MACS3', '{wildcards.group}') + ' && {params.cmd}'

rule consensus_peaks_seacr:
    input:
        peaks = lambda wc: expand(join(OUT_DIR, 'SEACR', '{s}', '{s}.bed.gz'),
                                  s=GROUPS[wc.group])
    output:
        final = join(OUT_DIR, 'SEACR', '{group}', 'finalPeakList.bed.gz')
    params:
        cmd = lambda wc: _naive_overlap_cmd(
            [join(OUT_DIR, 'SEACR', s, f'{s}.bed.gz') for s in GROUPS[wc.group]],
            join(OUT_DIR, 'SEACR', wc.group, 'finalPeakList.bed.gz'),
            n_fields=6)
    threads: 4
    resources:
        mem_mb = 8000
    log:
        join(OUT_DIR, 'Logs', 'SEACR', '{group}.naiveOverlap.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'SEACR', '{group}.naiveOverlap.tsv')
    message:
        '--- SEACR naive-overlap consensus for group "{wildcards.group}"'
    conda: CONDA_ENV
    shell:
        'mkdir -p ' + join(OUT_DIR, 'SEACR', '{wildcards.group}') + ' && {params.cmd}'

