rule deeptools_multiBamSummary:
    """Bin-wise read coverage across all (target + control) filtered BAMs."""
    input:
        bams = expand(join(OUT_DIR, 'Bowtie2', 'target', '{s}.filt.bam'),     s=ALL_SAMPLES),
        bais = expand(join(OUT_DIR, 'Bowtie2', 'target', '{s}.filt.bam.bai'), s=ALL_SAMPLES),
    output:
        npz = join(OUT_DIR, 'DeepTools', 'qc', 'multiBamSummary.npz')
    params:
        bs     = DT_QC_BIN_SIZE,
        labels = ' '.join(ALL_SAMPLES),
    threads: 8
    resources:
        mem_mb = 16000
    log:
        join(OUT_DIR, 'Logs', 'DeepTools', 'multiBamSummary.log')
    conda: CONDA_ENV
    shell:
        'multiBamSummary bins'
        ' --binSize {params.bs}'
        ' --bamfiles {input.bams}'
        ' --labels {params.labels}'
        ' -p {threads}'
        ' -o {output.npz} > {log} 2>&1'

rule deeptools_plotCorrelation:
    input:
        npz = join(OUT_DIR, 'DeepTools', 'qc', 'multiBamSummary.npz')
    output:
        png = join(OUT_DIR, 'DeepTools', 'qc', 'correlation.heatmap.png'),
        tab = join(OUT_DIR, 'DeepTools', 'qc', 'correlation.matrix.tab'),
    params:
        method = DT_QC_CORR_METHOD,
    log:
        join(OUT_DIR, 'Logs', 'DeepTools', 'plotCorrelation.log')
    conda: CONDA_ENV
    shell:
        'plotCorrelation'
        ' --corData {input.npz}'
        ' --corMethod {params.method}'
        ' --whatToPlot heatmap'
        ' --skipZeros --plotNumbers'
        ' --colorMap viridis'
        ' -o {output.png}'
        ' --outFileCorMatrix {output.tab} > {log} 2>&1'

rule deeptools_plotPCA:
    input:
        npz = join(OUT_DIR, 'DeepTools', 'qc', 'multiBamSummary.npz')
    output:
        png = join(OUT_DIR, 'DeepTools', 'qc', 'pca.png'),
        tab = join(OUT_DIR, 'DeepTools', 'qc', 'pca.tab'),
    log:
        join(OUT_DIR, 'Logs', 'DeepTools', 'plotPCA.log')
    conda: CONDA_ENV
    shell:
        'plotPCA'
        ' --corData {input.npz}'
        ' -o {output.png}'
        ' --outFileNameData {output.tab} > {log} 2>&1'

rule deeptools_plotFingerprint:
    """Per-sample cumulative-coverage fingerprint (enrichment QC)."""
    input:
        bam = join(OUT_DIR, 'Bowtie2', 'target', '{sample}.filt.bam'),
        bai = join(OUT_DIR, 'Bowtie2', 'target', '{sample}.filt.bam.bai'),
    output:
        png = join(OUT_DIR, 'DeepTools', 'qc', 'fingerprint', '{sample}.png'),
        raw = join(OUT_DIR, 'DeepTools', 'qc', 'fingerprint', '{sample}.raw.tab'),
        qcm = join(OUT_DIR, 'DeepTools', 'qc', 'fingerprint', '{sample}.qcmetrics.tab'),
    params:
        nsamples = DT_FINGERPRINT_SAMPLES,
        bs       = DT_FINGERPRINT_BINSIZE,
    threads: 4
    resources:
        mem_mb = 8000
    log:
        join(OUT_DIR, 'Logs', 'DeepTools', 'fingerprint', '{sample}.log')
    conda: CONDA_ENV
    shell:
        'plotFingerprint'
        ' -b {input.bam} --labels {wildcards.sample}'
        ' --numberOfSamples {params.nsamples} --binSize {params.bs}'
        ' -p {threads}'
        ' --plotFile {output.png}'
        ' --outRawCounts {output.raw}'
        ' --outQualityMetrics {output.qcm} > {log} 2>&1'

##--------------------------------------------------------------------------------------##
## MultiQC
##--------------------------------------------------------------------------------------##

def _multiqc_inputs(_wc=None):
    inputs = []
    inputs += expand(join(OUT_DIR, 'fastQC', '{s}.R2_fastqc.html'), s=ALL_SAMPLES)
    inputs += expand(join(OUT_DIR, 'trimmed_reads', '{s}.qc.txt'), s=ALL_SAMPLES)
    inputs += expand(join(OUT_DIR, 'Logs', 'Bowtie2', '{s}.target.bowtie2.log'), s=ALL_SAMPLES)
    inputs += expand(join(OUT_DIR, 'Bowtie2', 'target', '{s}.flagstat'), s=ALL_SAMPLES)
    inputs += expand(join(OUT_DIR, 'Bowtie2', 'target', '{s}.dupmark.metrics'), s=ALL_SAMPLES)
    inputs += expand(join(OUT_DIR, 'Bowtie2', 'target', '{s}.insert_size_metrics.txt'), s=ALL_SAMPLES)
    inputs += expand(join(OUT_DIR, 'Bowtie2', 'target', '{s}', 'bamqc', 'qualimapReport.html'), s=ALL_SAMPLES)
    inputs += expand(join(OUT_DIR, 'MACS3', '{s}', '{s}_peaks.narrowPeak'), s=TARGET_SAMPLES)
    if USE_SPIKEIN:
        inputs += expand(join(OUT_DIR, 'Logs', 'Bowtie2', '{s}.spikein.bowtie2.log'), s=ALL_SAMPLES)
    inputs += [join(OUT_DIR, 'DeepTools', 'genes.heatmap.png')]
    # DeepTools QC outputs picked up by the MultiQC deeptools module
    inputs += [
        join(OUT_DIR, 'DeepTools', 'qc', 'correlation.matrix.tab'),
        join(OUT_DIR, 'DeepTools', 'qc', 'pca.tab'),
    ]
    inputs += expand(join(OUT_DIR, 'DeepTools', 'qc', 'fingerprint', '{s}.qcmetrics.tab'),
                     s=ALL_SAMPLES)
    return inputs

rule multiqc:
    input:
        _multiqc_inputs
    output:
        report = join(OUT_DIR, 'MultiQC', 'multiqc_report.html')
    log:
        join(OUT_DIR, 'Logs', 'MultiQC', 'multiqc.log')
    message:
        '--- Running MultiQC'
    conda: CONDA_ENV
    shell:
        'multiqc -f -o ' + join(OUT_DIR, 'MultiQC') + ' ' + OUT_DIR + ' > {log} 2>&1'

##--------------------------------------------------------------------------------------##
## DiffBind: samplesheet + parametrised Jupyter notebook (R kernel)
##--------------------------------------------------------------------------------------##

def _diffbind_peak_inputs(_wc=None):
    """Per-replicate peak files the DiffBind samplesheet references — declared
    so Snakemake builds them before generating the CSV."""
    if DIFFBIND_PEAKCALLER == 'macs3':
        return expand(join(OUT_DIR, 'MACS3', '{s}', '{s}_peaks.narrowPeak'),
                      s=TARGET_SAMPLES)
    return expand(join(OUT_DIR, 'SEACR', '{s}', '{s}.' + SEACR_MODE + '.bed'),
                  s=TARGET_SAMPLES)

def _diffbind_control_bams(_wc=None):
    return [join(OUT_DIR, 'pooled_controls', f'{ct}.pooled.bam')
            for ct in USED_CONTROL_TYPES]

rule diffbind_samplesheet:
    input:
        bams  = expand(join(OUT_DIR, 'Bowtie2', 'target', '{s}.filt.bam'),
                       s=TARGET_SAMPLES),
        bais  = expand(join(OUT_DIR, 'Bowtie2', 'target', '{s}.filt.bam.bai'),
                       s=TARGET_SAMPLES),
        ctrls = _diffbind_control_bams,
        peaks = _diffbind_peak_inputs,
        cfg   = workflow.configfiles[0] if getattr(workflow, 'configfiles', None) else 'config.yml',
    output:
        csv = join(OUT_DIR, 'DiffBind', 'samplesheet.csv')
    params:
        caller = DIFFBIND_PEAKCALLER,
        script = 'scripts/build_diffbind_samplesheet.py',
    log:
        join(OUT_DIR, 'Logs', 'DiffBind', 'samplesheet.log')
    message:
        '--- Building DiffBind samplesheet (peakcaller={params.caller})'
    conda: CONDA_ENV
    shell:
        'python {params.script}'
        ' --config {input.cfg}'
        ' --peakcaller {params.caller}'
        ' --out {output.csv} > {log} 2>&1'

rule diffbind_notebook:
    """Execute the DiffBind R notebook via papermill, injecting parameters."""
    input:
        samplesheet = join(OUT_DIR, 'DiffBind', 'samplesheet.csv'),
        notebook    = 'notebooks/diffbind_analysis.ipynb',
    output:
        nb        = join(OUT_DIR, 'DiffBind', 'diffbind_analysis.executed.ipynb'),
        html      = join(OUT_DIR, 'DiffBind', 'diffbind_analysis.html'),
        consensus = join(OUT_DIR, 'DiffBind', 'consensus_peaks.bed'),
        rds       = join(OUT_DIR, 'DiffBind', 'dba_analysis.rds'),
    params:
        outdir        = join(OUT_DIR, 'DiffBind'),
        min_overlap   = DIFFBIND_MIN_OVERLAP,
        fdr_threshold = DIFFBIND_FDR_THRESHOLD,
    threads: 4
    resources:
        mem_mb = 16000
    log:
        join(OUT_DIR, 'Logs', 'DiffBind', 'notebook.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'DiffBind', 'notebook.tsv')
    message:
        '--- Running DiffBind notebook (papermill, R kernel)'
    conda: DIFFBIND_CONDA_ENV
    shell:
        # Use $CONDA_PREFIX/bin/* explicitly to dodge ~/.local/bin shims (e.g. a stale
        # jupyter shim whose shebang points at a deleted env) that win on PATH order.
        '"$CONDA_PREFIX/bin/papermill" {input.notebook} {output.nb}'
        ' -p samplesheet_path {input.samplesheet}'
        ' -p outdir {params.outdir}'
        ' -p min_overlap {params.min_overlap}'
        ' -p fdr_threshold {params.fdr_threshold}'
        ' --kernel ir > {log} 2>&1'
        # --output sets the basename (no extension); without it nbconvert names the
        # file after the input stem (…executed.html), which wouldn't match the rule's
        # declared output and would trigger Snakemake's incomplete-output cleanup.
        ' && "$CONDA_PREFIX/bin/jupyter" nbconvert --to html'
        ' --output diffbind_analysis'
        ' --output-dir {params.outdir} {output.nb} >> {log} 2>&1'
