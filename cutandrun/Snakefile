    params:
        bs = DT_BIN_SIZE,
        body = DT_REGION_BODY,
        before = DT_BEFORE_REGION,
        after = DT_AFTER_REGION,
    threads: 8
    resources:
        mem_mb = 16000
    log:
        join(OUT_DIR, 'Logs', 'DeepTools', 'computeMatrix.genes.log')
    conda: CONDA_ENV
    shell:
        'computeMatrix scale-regions'
        ' -S {input.bws} -R {input.bed}'
        ' -b {params.before} -a {params.after} -m {params.body}'
        ' --binSize {params.bs} --skipZeros -p {threads}'
        ' -o {output.matrix} > {log} 2>&1'

