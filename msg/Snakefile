def _thin_inputs(wc):
    base = join(OUT_DIR, 'ancestry_data')
    inputs = {
        'par2':  join(base, 'ancestry-probs-par2.pulled.tsv'),
        'pheno': join(base, 'pheno.pulled.tsv'),
    }
    if F2:
        inputs['par1'] = join(base, 'ancestry-probs-par1.pulled.tsv')
    return inputs

def _thin_outputs():
    base = join(OUT_DIR, 'ancestry_data')
    outs = {'par2_thin': join(base, 'ancestry-probs-par2.thinned.tsv')}
    if F2:
        outs['par1_thin'] = join(base, 'ancestry-probs-par1.thinned.tsv')
    return outs

rule pt_thin:
    input:
        unpack(_thin_inputs),
    output:
        **_thin_outputs(),
    params:
        chroms          = config['fit_hmm']['chroms'],
        xchroms         = config['fit_hmm']['sexchrom'],
        diffac          = config['fit_hmm']['diffac'],
        num_markers     = config['fit_hmm']['num_markers'],
        ignore_nan      = config['fit_hmm']['ignore_nan'],
        autosome_prior  = config['fit_hmm']['autosome_prior'],
        x_prior         = config['fit_hmm']['x_prior'],
        sex_all         = config['fit_hmm']['sex'],
        f2_args         = (lambda wc:
            f' --par1 {join(OUT_DIR, "ancestry_data", "ancestry-probs-par1.pulled.tsv")}'
            f' --par1-out {join(OUT_DIR, "ancestry_data", "ancestry-probs-par1.thinned.tsv")}'
            if F2 else ''),
        nm_arg          = (lambda wc:
            f' --num-markers {config["fit_hmm"]["num_markers"]}'
            if config['fit_hmm']['num_markers'] not in (None, "null") else ''),
    log:
        join(OUT_DIR, 'Logs', 'pt_thin.log')
    message:
        '--- Thinning markers (cross={CROSS})'
    threads: 1
    resources:
        mem_mb=64000
    conda:
        'envs/msg_py3.yml'
    shell:
        'python {SCRIPTS_DIR}/thin_markers.py'
            ' --par2 {input.par2}'
            ' --par2-out {output.par2_thin}'
            ' --chroms {params.chroms}'
            ' --xchroms {params.xchroms}'
            ' --diffac {params.diffac}'
            ' --ignore-nan {params.ignore_nan}'
            ' --autosome-prior {params.autosome_prior}'
            ' --x-prior {params.x_prior}'
            ' --sex-all {params.sex_all}'
            ' --phenofile {input.pheno}'
            '{params.nm_arg}'
            '{params.f2_args}'
            ' > {log} 2>&1'

rule pt_f2_reduce:
    input:
        par1 = join(OUT_DIR, 'ancestry_data', 'ancestry-probs-par1.thinned.tsv'),
        par2 = join(OUT_DIR, 'ancestry_data', 'ancestry-probs-par2.thinned.tsv'),
        pheno = join(OUT_DIR, 'ancestry_data', 'pheno.pulled.tsv'),
    output:
        par1_out = join(OUT_DIR, 'ancestry_data',
                        'ancestry-probs-par1.thinned.f2_rqtl.tsv'),
        par2_out = join(OUT_DIR, 'ancestry_data',
                        'ancestry-probs-par2.thinned.f2_rqtl.tsv'),
    params:
        xchroms = config['fit_hmm']['sexchrom'],
        sex_all = config['fit_hmm']['sex'],
    log:
        join(OUT_DIR, 'Logs', 'pt_f2_reduce.log')
    message:
        '--- F2 X-chrom prob slot conversion (side artifact)'
    threads: 1
    resources:
        mem_mb=8000
    conda:
        'envs/msg_py3.yml'
    shell:
        'python {SCRIPTS_DIR}/f2_reduce_prob_slots.py'
            ' --par1 {input.par1}'
            ' --par2 {input.par2}'
            ' --par1-out {output.par1_out}'
            ' --par2-out {output.par2_out}'
            ' --xchroms {params.xchroms}'
            ' --sex-all {params.sex_all}'
            ' --phenofile {input.pheno}'
            ' > {log} 2>&1'

def _rqtl_inputs(wc):
    base = join(OUT_DIR, 'ancestry_data')
    inputs = {
        'par2':  join(base, 'ancestry-probs-par2.thinned.tsv'),
        'pheno': join(base, 'pheno.pulled.tsv'),
    }
    if F2:
        inputs['par1'] = join(base, 'ancestry-probs-par1.thinned.tsv')
    return inputs

rule pt_to_rqtl:
    input:
        unpack(_rqtl_inputs),
    output:
        csv = join(OUT_DIR, 'ancestry_data', 'rqtl_genotypes.csv'),
    params:
        cross           = CROSS,
        xchroms         = config['fit_hmm']['sexchrom'],
        autosome_prior  = config['fit_hmm']['autosome_prior'],
        x_prior         = config['fit_hmm']['x_prior'],
        sex_all         = config['fit_hmm']['sex'],
        par1_arg        = (lambda wc:
            f' --par1 {join(OUT_DIR, "ancestry_data", "ancestry-probs-par1.thinned.tsv")}'
            if F2 else ''),
    log:
        join(OUT_DIR, 'Logs', 'pt_to_rqtl.log')
    message:
        '--- Converting to r/qtl CSV (cross={params.cross})'
    threads: 1
    resources:
        mem_mb=8000
    conda:
        'envs/msg_py3.yml'
    shell:
        'python {SCRIPTS_DIR}/tsv_to_rqtl.py'
            ' --cross {params.cross}'
            ' --par2 {input.par2}'
            '{params.par1_arg}'
            ' --output {output.csv}'
            ' --xchroms {params.xchroms}'
            ' --autosome-prior {params.autosome_prior}'
            ' --x-prior {params.x_prior}'
            ' --sex-all {params.sex_all}'
            ' --phenofile {input.pheno}'
            ' > {log} 2>&1'

##--------------------------------------------------------------------------------------##
## samtools flagstat / stats / idxstats per sorted BAM (feeds MultiQC)
##--------------------------------------------------------------------------------------##

rule samtools_stats:
    input:
        bam = join(OUT_DIR, 'bam_dir', '{sample}_{parent}.sorted.bam'),
        bai = join(OUT_DIR, 'bam_dir', '{sample}_{parent}.sorted.bam.bai'),
    output:
        flagstat = join(OUT_DIR, 'qc', 'samtools',
                        '{sample}_{parent}.flagstat.txt'),
        stats    = join(OUT_DIR, 'qc', 'samtools',
                        '{sample}_{parent}.stats.txt'),
        idxstats = join(OUT_DIR, 'qc', 'samtools',
                        '{sample}_{parent}.idxstats.txt'),
    log:
        join(OUT_DIR, 'Logs', 'samtools_stats', '{sample}_{parent}.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'samtools_stats',
             '{sample}_{parent}.benchmark.tsv')
    message:
        '--- samtools stats: {wildcards.sample} → {wildcards.parent}'
    threads: 2
    resources:
        mem_mb=2000
    conda:
        'envs/msg_py3.yml'
    wildcard_constraints:
        parent = '|'.join(PARENTS.keys())
    shell:
        '(samtools flagstat -@ {threads} {input.bam} > {output.flagstat}'
        ' && samtools stats    -@ {threads} {input.bam} > {output.stats}'
        ' && samtools idxstats          {input.bam} > {output.idxstats}'
        ') 2> {log}'

##--------------------------------------------------------------------------------------##
## MultiQC: collate fastQC, cutadapt, bwa-mem, qualimap (aligned + filtered),
## and samtools stats into a single report.
##--------------------------------------------------------------------------------------##

rule multiQC:
    input:
        expand(join(OUT_DIR, 'fastQC',      '{sample}.R1_fastqc.html'),
               sample=SAMPLES),
        expand(join(OUT_DIR, 'fastQC_trim', '{sample}.R1_fastqc.html'),
               sample=SAMPLES),
        expand(join(OUT_DIR, 'Logs', 'cutadapt', '{sample}.cutadapt.log'),
               sample=SAMPLES),
        expand(join(OUT_DIR, 'Logs', 'bwa_mem', '{sample}_{parent}.log'),
               sample=SAMPLES, parent=PARENTS.keys()),
        expand(join(OUT_DIR, 'bamqc', 'aligned',
                    '{sample}_{parent}', 'qualimapReport.html'),
               sample=SAMPLES, parent=PARENTS.keys()),
        expand(join(OUT_DIR, 'bamqc', 'filtered',
                    '{sample}_par1', 'qualimapReport.html'),
               sample=SAMPLES),
        expand(join(OUT_DIR, 'qc', 'samtools',
                    '{sample}_{parent}.flagstat.txt'),
               sample=SAMPLES, parent=PARENTS.keys()),
        expand(join(OUT_DIR, 'qc', 'samtools',
                    '{sample}_{parent}.stats.txt'),
               sample=SAMPLES, parent=PARENTS.keys()),
        expand(join(OUT_DIR, 'qc', 'samtools',
                    '{sample}_{parent}.idxstats.txt'),
               sample=SAMPLES, parent=PARENTS.keys()),
    output:
        report = join(OUT_DIR, 'MultiQC', 'multiqc_report.html'),
    params:
        outdir = join(OUT_DIR, 'MultiQC'),
        scan_dirs = ' '.join([
            join(OUT_DIR, 'fastQC'),
            join(OUT_DIR, 'fastQC_trim'),
            join(OUT_DIR, 'Logs', 'cutadapt'),
            join(OUT_DIR, 'Logs', 'bwa_mem'),
            join(OUT_DIR, 'bamqc'),
            join(OUT_DIR, 'qc', 'samtools'),
        ]),
    log:
        join(OUT_DIR, 'Logs', 'MultiQC', 'multiQC.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'MultiQC', 'multiQC.benchmark.tsv')
    message:
        '--- Running MultiQC'
    threads: 1
    resources:
        mem_mb=4000
    conda:
        'envs/msg_py3.yml'
    shell:
        'multiqc -f -o {params.outdir} -d -dd 1 {params.scan_dirs}'
        ' > {log} 2>&1'

