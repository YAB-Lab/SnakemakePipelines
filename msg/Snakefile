        # expand(join(OUT_DIR, 'bam_dir', '{sample}_{parent}.qnsorted.bam'),
        #        sample=SAMPLES, parent=PARENTS.keys()),
        # expand(join(OUT_DIR, 'hmm_data', '{sample}',
        #             'aln_{sample}_par1-filtered.bam'),
        #        sample=SAMPLES),
        # expand(join(OUT_DIR, 'hmm_data', '{sample}', '.pileups.done'),
        #        sample=SAMPLES),
        # expand(join(OUT_DIR, 'hmm_data', '{sample}', '.hmm.done'),
        #        sample=SAMPLES),
        # join(OUT_DIR, 'msg.chrLengths'),
        # expand(join(OUT_DIR, 'hmm_fit', '{sample}', '{sample}-hmmprob.pdf'),
        #        sample=SAMPLES),
        # join(OUT_DIR, 'ancestry_data', 'ancestry-probs-par1.tsv'),
        # join(OUT_DIR, 'ancestry_data', 'ancestry-probs-par2.tsv'),
        # join(OUT_DIR, 'ancestry_data', 'ancestry-probs-par1par2.tsv'),
        # join(OUT_DIR, 'ancestry_data', 'ancestry-probs-par2.thinned.tsv'),
        join(OUT_DIR, 'ancestry_data', 'rqtl_genotypes.csv'),
        *([join(OUT_DIR, 'ancestry_data', 'ancestry-probs-par1.thinned.tsv'),
           join(OUT_DIR, 'ancestry_data', 'ancestry-probs-par1.thinned.f2_rqtl.tsv'),
           join(OUT_DIR, 'ancestry_data', 'ancestry-probs-par2.thinned.f2_rqtl.tsv')]
