import json
import os
from os.path import join, basename, dirname, isfile

##--------------------------------------------------------------------------------------##
## Global config
##--------------------------------------------------------------------------------------##

configfile: 'config.yml'

OUT_DIR       = config['OUT_DIR']
SCRIPTS_DIR   = config['SCRIPTS_DIR']
PHENO_FILE    = config['PHENO_FILE']

# Parental reference genomes (uncompressed FASTA). Positional naming
# (par1/par2) keeps the pipeline parent-agnostic — downstream rules iterate
# over PARENTS.keys() rather than hard-coding genome names.
PARENTS = {
    'par1': config['PARENT_1_DNA'],
    'par2': config['PARENT_2_DNA'],
}

FILES   = json.load(open(config['PE_DNA_SAMPLES_JSON']))
SAMPLES = sorted(FILES.keys())

CROSS = config['fit_hmm']['cross'].lower()  # 'bc' or 'f2'
F2    = (CROSS == 'f2')

os.makedirs(OUT_DIR, exist_ok=True)

##--------------------------------------------------------------------------------------##
## Final targets
##--------------------------------------------------------------------------------------##

