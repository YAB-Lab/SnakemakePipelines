##--------------------------------------------------------------------------------------##
## Stage parental FASTAs into the output tree (symlink, no copy)
##--------------------------------------------------------------------------------------##

rule stage_parent:
    input:
        fasta = lambda wc: PARENTS[wc.parent]
    output:
        fasta = join(OUT_DIR, 'parents', '{parent}',
                     '{parent}.fa')
    message:
        '--- Staging {wildcards.parent} FASTA into output tree'
    shell:
        'ln -sf {input.fasta} {output.fasta}'

##--------------------------------------------------------------------------------------##
## BWA indexes — one job per parental genome, run in parallel by the scheduler
##--------------------------------------------------------------------------------------##

rule INDEXES:
    input:
        fasta = join(OUT_DIR, 'parents', '{parent}', '{parent}.fa')
    output:
        ann = join(OUT_DIR, 'parents', '{parent}', '{parent}.fa.ann'),
        amb = join(OUT_DIR, 'parents', '{parent}', '{parent}.fa.amb'),
        bwt = join(OUT_DIR, 'parents', '{parent}', '{parent}.fa.bwt'),
        pac = join(OUT_DIR, 'parents', '{parent}', '{parent}.fa.pac'),
        sa  = join(OUT_DIR, 'parents', '{parent}', '{parent}.fa.sa'),
    log:
        join(OUT_DIR, 'Logs', 'bwa_index.{parent}.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'bwa_index.{parent}.benchmark.tsv')
    message:
        '--- Building BWA index for {wildcards.parent}'
    threads: 1
    resources:
        mem_mb=8000
    conda:
        'envs/msg_py3.yml'
    wildcard_constraints:
        parent = '|'.join(PARENTS.keys())
    shell:
        'bwa index {input.fasta} 2> {log}'

##--------------------------------------------------------------------------------------##
## FastQC on raw reads
##--------------------------------------------------------------------------------------##

rule fastqc1:
    input:
        r1 = lambda wildcards: FILES[wildcards.sample]['R1'],
        r2 = lambda wildcards: FILES[wildcards.sample]['R2'],
    output:
        r1 = join(OUT_DIR, 'fastQC', '{sample}.R1_fastqc.html'),
        r2 = join(OUT_DIR, 'fastQC', '{sample}.R2_fastqc.html'),
    log:
        join(OUT_DIR, 'Logs', 'fastQC', '{sample}.fastQC.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'fastQC', '{sample}.fastQC.benchmark.tsv')
    message:
        '--- Checking read quality of sample "{wildcards.sample}" with FastQC'
    conda:
        'envs/msg_py3.yml'
    shell:
        'fastqc'
            ' -o ' + join(OUT_DIR, 'fastQC') +
            ' -t 4'
            ' -q'
            ' {input.r1} {input.r2}'
            ' > {log} 2>&1'

##--------------------------------------------------------------------------------------##
## Adapter & quality trimming with cutadapt (PE)
##--------------------------------------------------------------------------------------##

rule cutADAPT:
    input:
        r1 = lambda wildcards: FILES[wildcards.sample]['R1'],
        r2 = lambda wildcards: FILES[wildcards.sample]['R2']
    output:
        fastq1 = join(OUT_DIR, 'trimmed_reads', '{sample}.R1.fastq.gz'),
        fastq2 = join(OUT_DIR, 'trimmed_reads', '{sample}.R2.fastq.gz'),
        qc     = join(OUT_DIR, 'trimmed_reads', '{sample}.qc.txt')
    params:
        # https://cutadapt.readthedocs.io/en/stable/guide.html#adapter-types
        adapters = '-a CTGTCTCTTATACACATCT -A CTGTCTCTTATACACATCT',
        # https://cutadapt.readthedocs.io/en/stable/guide.html#
        extra    = '--minimum-length 30 -q 20'
    log:
        join(OUT_DIR, 'Logs', 'cutadapt', '{sample}.cutadapt.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'cutadapt', '{sample}.cutadapt.benchmark.tsv')
    message:
        '--- Trimming adaptors for sample {wildcards.sample}'
    threads: 4
    resources:
        mem_mb=8000
    wrapper:
        'v3.10.2/bio/cutadapt/pe'

##--------------------------------------------------------------------------------------##
## FastQC on trimmed reads
##--------------------------------------------------------------------------------------##

rule fastqc2:
    input:
        fastq1 = join(OUT_DIR, 'trimmed_reads', '{sample}.R1.fastq.gz'),
        fastq2 = join(OUT_DIR, 'trimmed_reads', '{sample}.R2.fastq.gz'),
    output:
        r1 = join(OUT_DIR, 'fastQC_trim', '{sample}.R1_fastqc.html'),
        r2 = join(OUT_DIR, 'fastQC_trim', '{sample}.R2_fastqc.html'),
    log:
        join(OUT_DIR, 'Logs', 'fastQC_trim', '{sample}.fastQC.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'fastQC_trim', '{sample}.fastQC.benchmark.tsv')
    message:
        '--- Checking read quality of trimmed sample "{wildcards.sample}" with FastQC'
    conda:
        'envs/msg_py3.yml'
    shell:
        'fastqc'
            ' -o ' + join(OUT_DIR, 'fastQC_trim') +
            ' -t 4'
            ' -q'
            ' {input.fastq1} {input.fastq2}'
            ' > {log} 2>&1'

##--------------------------------------------------------------------------------------##
## BWA-MEM paired-end mapping — one job per (sample, parent), run in parallel
##--------------------------------------------------------------------------------------##

rule BWA_MEM:
    input:
        r1  = join(OUT_DIR, 'trimmed_reads', '{sample}.R1.fastq.gz'),
        r2  = join(OUT_DIR, 'trimmed_reads', '{sample}.R2.fastq.gz'),
        bwt = join(OUT_DIR, 'parents', '{parent}', '{parent}.fa.bwt'),
    output:
        bam = join(OUT_DIR, 'bam_dir', '{sample}_{parent}.qnsorted.bam')
    params:
        prefix = lambda wc: join(OUT_DIR, 'parents', wc.parent, f'{wc.parent}.fa'),
        rg     = lambda wc: rf'@RG\tID:{wc.sample}\tSM:{wc.sample}\tPL:ILLUMINA',
        extra  = config.get('bwa_mem', {}).get('extra', ''),
    log:
        join(OUT_DIR, 'Logs', 'bwa_mem', '{sample}_{parent}.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'bwa_mem', '{sample}_{parent}.benchmark.tsv')
    message:
        '--- BWA-MEM: {wildcards.sample} -> {wildcards.parent} (qname-sorted BAM)'
    threads: 8
    resources:
        mem_mb=16000
    conda:
        'envs/msg_py3.yml'
    wildcard_constraints:
        parent = '|'.join(PARENTS.keys())
    shell:
        '(bwa mem'
            ' -t {threads}'
            ' -R "{params.rg}"'
            ' {params.extra}'
            ' {params.prefix}'
            ' {input.r1} {input.r2}'
            ' | samtools sort -n -@ {threads} -o {output.bam} -)'
            ' 2> {log}'

##--------------------------------------------------------------------------------------##
## Extract reference alleles from PE alignments (Python3 rewrite)
##--------------------------------------------------------------------------------------##

rule extractRefAllele:
    input:
        bam_p1 = join(OUT_DIR, 'bam_dir', '{sample}_par1.qnsorted.bam'),
        bam_p2 = join(OUT_DIR, 'bam_dir', '{sample}_par2.qnsorted.bam'),
    output:
        bam1 = join(OUT_DIR, 'hmm_data', '{sample}',
                    'aln_{sample}_par1-filtered.bam'),
        bam2 = join(OUT_DIR, 'hmm_data', '{sample}',
                    'aln_{sample}_par2-filtered.bam'),
    params:
        par1     = lambda wc: PARENTS['par1'],
        par2     = lambda wc: PARENTS['par2'],
        outdir   = lambda wc: join(OUT_DIR, 'hmm_data', wc.sample),
        chroms   = config.get('extract_ref', {}).get('chroms', 'all'),
        repeat   = config.get('extract_ref', {}).get('repeat_threshold', 6),
        script   = join(SCRIPTS_DIR, 'extract_ref_alleles.py'),
    log:
        join(OUT_DIR, 'Logs', 'extract_ref_allele', '{sample}.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'extract_ref_allele', '{sample}.benchmark.tsv')
    message:
        '--- Extracting reference alleles for {wildcards.sample}'
    threads: 1
    resources:
        mem_mb=16000
    conda:
        'envs/msg_py3.yml'
    shell:
        'python {params.script}'
            ' -i {wildcards.sample}'
            ' --bam-par1 {input.bam_p1}'
            ' --bam-par2 {input.bam_p2}'
            ' --parent1 {params.par1}'
            ' --parent2 {params.par2}'
            ' -o {params.outdir}'
            ' --chroms {params.chroms}'
            ' --repeat-threshold {params.repeat}'
            ' > {log} 2>&1'

##--------------------------------------------------------------------------------------##
## Per-contig pileups (par1 only — par2 alleles come from extract step's lookup tables)
##--------------------------------------------------------------------------------------##

rule makePileups:
    input:
        bam     = join(OUT_DIR, 'hmm_data', '{sample}', 'aln_{sample}_par1-filtered.bam'),
        par1_fa = join(OUT_DIR, 'parents', 'par1', 'par1.fa'),
    output:
        sorted_bam = join(OUT_DIR, 'hmm_data', '{sample}',
                          'aln_{sample}_par1-filtered-sorted.bam'),
        sorted_bai = join(OUT_DIR, 'hmm_data', '{sample}',
                          'aln_{sample}_par1-filtered-sorted.bam.bai'),
        done       = touch(join(OUT_DIR, 'hmm_data', '{sample}', '.pileups.done')),
    params:
        sample_dir = lambda wc: join(OUT_DIR, 'hmm_data', wc.sample),
        prefix     = lambda wc: join(OUT_DIR, 'hmm_data', wc.sample,
                                     f'aln_{wc.sample}_par1-filtered'),
    log:
        join(OUT_DIR, 'Logs', 'makePileups', '{sample}.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'makePileups', '{sample}.benchmark.tsv')
    message:
        '--- Per-contig pileups for {wildcards.sample} (par1)'
    threads: 4
    resources:
        mem_mb=8000
    conda:
        'envs/msg_py3.yml'
    shell:
        r"""
        (
            set -e
            samtools sort -@ {threads} -o {output.sorted_bam} {input.bam}
            samtools index {output.sorted_bam}
            samtools faidx {input.par1_fa}

            shopt -s nullglob
            for refs_file in {params.sample_dir}/refs/par1/*-ref.alleles; do
                contig=$(basename "$refs_file" -ref.alleles)
                samtools mpileup -B -f {input.par1_fa} -r "$contig" {output.sorted_bam} \
                    > {params.prefix}-"${{contig}}"-sorted.pileup
            done
        ) > {log} 2>&1
        """

##--------------------------------------------------------------------------------------##
## Build per-contig HMM input data (modern R script — no msg/countalleles binary)
##--------------------------------------------------------------------------------------##

rule writeHMM:
    input:
        pileups_done = join(OUT_DIR, 'hmm_data', '{sample}', '.pileups.done'),
    output:
        done = touch(join(OUT_DIR, 'hmm_data', '{sample}', '.hmm.done')),
    params:
        sample_dir = lambda wc: join(OUT_DIR, 'hmm_data', wc.sample),
        chroms     = config.get('write_hmm', {}).get('chroms', 'all'),
        script     = join(SCRIPTS_DIR, 'write_hmm_data.R'),
    log:
        join(OUT_DIR, 'Logs', 'writeHMM', '{sample}.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'writeHMM', '{sample}.benchmark.tsv')
    message:
        '--- Building HMM input data for {wildcards.sample}'
    threads: 1
    resources:
        mem_mb=8000
    conda:
        'envs/r_msg_v2.yml'
    shell:
        'Rscript {params.script}'
            ' -i {wildcards.sample}'
            ' -d {params.sample_dir}'
            ' -c {params.chroms}'
            ' > {log} 2>&1'

##--------------------------------------------------------------------------------------##
## Coord-sort BWA_MEM BAMs (qname-sorted upstream) — needed for QC + indexing
##--------------------------------------------------------------------------------------##

rule sort_aligned_bam:
    input:
        bam = join(OUT_DIR, 'bam_dir', '{sample}_{parent}.qnsorted.bam'),
    output:
        bam = join(OUT_DIR, 'bam_dir', '{sample}_{parent}.sorted.bam'),
        bai = join(OUT_DIR, 'bam_dir', '{sample}_{parent}.sorted.bam.bai'),
    threads: 4
    resources:
        mem_mb=8000
    conda:
        'envs/msg_py3.yml'
    wildcard_constraints:
        parent = '|'.join(PARENTS.keys())
    shell:
        'samtools sort -@ {threads} -o {output.bam} {input.bam}'
        ' && samtools index {output.bam}'

##--------------------------------------------------------------------------------------##
## Qualimap on raw aligned BAMs (sample × parent)
##--------------------------------------------------------------------------------------##

rule qualimap_aligned:
    input:
        bam = join(OUT_DIR, 'bam_dir', '{sample}_{parent}.sorted.bam'),
    output:
        report = join(OUT_DIR, 'bamqc', 'aligned',
                      '{sample}_{parent}', 'qualimapReport.html'),
    params:
        outdir = lambda wc: join(OUT_DIR, 'bamqc', 'aligned',
                                 f'{wc.sample}_{wc.parent}'),
    log:
        join(OUT_DIR, 'Logs', 'qualimap_aligned', '{sample}_{parent}.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'qualimap_aligned',
             '{sample}_{parent}.benchmark.tsv')
    message:
        '--- Qualimap on aligned BAM: {wildcards.sample} → {wildcards.parent}'
    threads: 4
    resources:
        mem_mb=8000
    conda:
        'envs/msg_py3.yml'
    wildcard_constraints:
        parent = '|'.join(PARENTS.keys())
    shell:
        'unset DISPLAY; qualimap bamqc'
            ' -bam {input.bam}'
            ' -c'
            ' -outdir {params.outdir}'
            ' --java-mem-size=8G'
            ' -nt {threads}'
            ' > {log} 2>&1'

##--------------------------------------------------------------------------------------##
## Qualimap on filtered + coord-sorted par1 BAMs (from makePileups)
##--------------------------------------------------------------------------------------##

rule qualimap_filtered:
    input:
        bam = join(OUT_DIR, 'hmm_data', '{sample}',
                   'aln_{sample}_par1-filtered-sorted.bam'),
    output:
        report = join(OUT_DIR, 'bamqc', 'filtered',
                      '{sample}_par1', 'qualimapReport.html'),
    params:
        outdir = lambda wc: join(OUT_DIR, 'bamqc', 'filtered',
                                 f'{wc.sample}_par1'),
    log:
        join(OUT_DIR, 'Logs', 'qualimap_filtered', '{sample}.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'qualimap_filtered',
             '{sample}.benchmark.tsv')
    message:
        '--- Qualimap on filtered BAM: {wildcards.sample} (par1)'
    threads: 4
    resources:
        mem_mb=8000
    conda:
        'envs/msg_py3.yml'
    shell:
        'unset DISPLAY; qualimap bamqc'
            ' -bam {input.bam}'
            ' -c'
            ' -outdir {params.outdir}'
            ' --java-mem-size=8G'
            ' -nt {threads}'
            ' > {log} 2>&1'

##--------------------------------------------------------------------------------------##
## Per-contig lengths CSV from par1 FASTA (single job, used by fit + downstream)
##--------------------------------------------------------------------------------------##

rule chromLengths:
    input:
        par1 = PARENTS['par1'],
    output:
        chr_len = join(OUT_DIR, 'msg.chrLengths'),
    log:
        join(OUT_DIR, 'Logs', 'chromLengths.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'chromLengths.benchmark.tsv')
    message:
        '--- Building per-contig lengths CSV from par1'
    threads: 1
    resources:
        mem_mb=1000
    conda:
        'envs/msg_py3.yml'
    shell:
        r"""
        (
            set -e
            faidx {input.par1} -i chromsizes \
                | tr "\t" "," > {output.chr_len}.tmp
            echo "chr,length" | cat - {output.chr_len}.tmp > {output.chr_len}
            rm {output.chr_len}.tmp
        ) > {log} 2>&1
        """

##--------------------------------------------------------------------------------------##
## Fit per-contig HMMs and emit ancestry plots (modern R script — no msg/ dependency)
##--------------------------------------------------------------------------------------##

rule fit:
    input:
        hmm_done = join(OUT_DIR, 'hmm_data', '{sample}', '.hmm.done'),
        chr_len  = join(OUT_DIR, 'msg.chrLengths'),
    output:
        pdf = join(OUT_DIR, 'hmm_fit', '{sample}', '{sample}-hmmprob.pdf'),
    params:
        script              = join(SCRIPTS_DIR, 'fit_hmm.R'),
        hmm_data_dir        = join(OUT_DIR, 'hmm_data'),
        outdir              = join(OUT_DIR, 'hmm_fit'),
        sex                 = config['fit_hmm']['sex'],
        deltapar1           = config['fit_hmm']['deltapar1'],
        deltapar2           = config['fit_hmm']['deltapar2'],
        rec_rate            = config['fit_hmm']['recRate'],
        rfac                = config['fit_hmm']['rfac'],
        chroms              = config['fit_hmm']['chroms'],
        sex_chroms          = config['fit_hmm']['sexchrom'],
        priors              = config['fit_hmm']['prior'],
        theta               = config['fit_hmm']['theta'],
        gff_thresh_conf     = config['fit_hmm']['gff_thresh_conf'],
        one_site_per_contig = config['fit_hmm']['one_site_per_contig'],
        chroms2plot         = config['fit_hmm']['chroms2plot'],
        pepthresh           = config['fit_hmm']['pepthresh'],
        use_filter_hmmdata  = config['fit_hmm']['use_filter_hmmdata_pl'],
    log:
        join(OUT_DIR, 'Logs', 'fit', '{sample}.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'fit', '{sample}.benchmark.tsv')
    message:
        '--- Fitting HMM for sample {wildcards.sample}'
    threads: 8
    resources:
        mem_mb=32000
    conda:
        'envs/r_msg_v2.yml'
    shell:
        'Rscript {params.script}'
            ' --indiv {wildcards.sample}'
            ' --hmm-data-dir {params.hmm_data_dir}'
            ' --outdir {params.outdir}'
            ' --chr-lengths {input.chr_len}'
            ' --sex {params.sex}'
            ' --deltapar1 {params.deltapar1}'
            ' --deltapar2 {params.deltapar2}'
            ' --rec-rate {params.rec_rate}'
            ' --rfac {params.rfac}'
            ' --chroms {params.chroms}'
            ' --sex-chroms {params.sex_chroms}'
            ' --priors {params.priors}'
            ' --theta {params.theta}'
            ' --gff-thresh-conf {params.gff_thresh_conf}'
            ' --one-site-per-contig {params.one_site_per_contig}'
            ' --chroms2plot {params.chroms2plot}'
            ' --pepthresh {params.pepthresh}'
            ' --use-filter-hmmdata {params.use_filter_hmmdata}'
            ' > {log} 2>&1'

##--------------------------------------------------------------------------------------##
## Aggregate per-sample fits into genome-wide ancestry tables + summary plots
##--------------------------------------------------------------------------------------##

rule ancestry_probs:
    input:
        pdfs    = expand(join(OUT_DIR, 'hmm_fit', '{sample}',
                              '{sample}-hmmprob.pdf'), sample=SAMPLES),
        chr_len = join(OUT_DIR, 'msg.chrLengths'),
    output:
        anc1    = join(OUT_DIR, 'ancestry_data', 'ancestry-probs-par1.tsv'),
        anc2    = join(OUT_DIR, 'ancestry_data', 'ancestry-probs-par2.tsv'),
        anc12   = join(OUT_DIR, 'ancestry_data', 'ancestry-probs-par1par2.tsv'),
        offdiag = join(OUT_DIR, 'hmm_fit_images', 'offdiagonal_data.tsv'),
        rhat    = join(OUT_DIR, 'hmm_fit_images', 'rhat-offdiag.rda'),
        rlod    = join(OUT_DIR, 'hmm_fit_images', 'rlod-offdiag.rda'),
        seg_pdf = join(OUT_DIR, 'hmm_fit_images', 'segregation.pdf'),
        miss_pdf = join(OUT_DIR, 'hmm_fit_images', 'missing.pdf'),
        lod_pdf  = join(OUT_DIR, 'hmm_fit_images', 'offdiagonal-lod.pdf'),
    params:
        script        = join(SCRIPTS_DIR, 'ancestry_probs.R'),
        hmm_fit_dir   = join(OUT_DIR, 'hmm_fit'),
        ancestry_dir  = join(OUT_DIR, 'ancestry_data'),
        images_dir    = join(OUT_DIR, 'hmm_fit_images'),
        chroms        = config['fit_hmm']['chroms'],
        chroms2plot   = config['fit_hmm']['chroms2plot'],
        thinfac       = config['fit_hmm']['thinfac'],
        diffac        = config['fit_hmm']['diffac'],
        pna_thresh    = config['fit_hmm']['pna_thresh'],
        plot_corr_mat = config['fit_hmm']['plot_correlation_matrix'],
        bp_widths     = config['fit_hmm']['breakpoint_widths'],
    log:
        join(OUT_DIR, 'Logs', 'ancestry_probs.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'ancestry_probs.benchmark.tsv')
    message:
        '--- Aggregating ancestry probabilities + summary plots'
    threads: 1
    resources:
        mem_mb=32000
    conda:
        'envs/r_msg_v2.yml'
    shell:
        'Rscript {params.script}'
            ' --hmm-fit-dir {params.hmm_fit_dir}'
            ' --ancestry-dir {params.ancestry_dir}'
            ' --images-dir {params.images_dir}'
            ' --chr-lengths {input.chr_len}'
            ' --chroms {params.chroms}'
            ' --chroms2plot {params.chroms2plot}'
            ' --thinfac {params.thinfac}'
            ' --diffac {params.diffac}'
            ' --pna-thresh {params.pna_thresh}'
            ' --plot-correlation-matrix {params.plot_corr_mat}'
            ' --breakpoint-widths {params.bp_widths}'
            ' > {log} 2>&1'

##--------------------------------------------------------------------------------------##
## pull_thin: factored into 5 small rules (sort -> pull -> thin -> [f2_reduce] -> rqtl)
##--------------------------------------------------------------------------------------##

rule pt_sort_phenofile:
    input:
        pheno = PHENO_FILE,
    output:
        sorted = join(OUT_DIR, 'ancestry_data', 'pheno.sorted.tsv'),
    log:
        join(OUT_DIR, 'Logs', 'pt_sort_phenofile.log')
    message:
        '--- Sorting phenofile by individual ID'
    threads: 1
    resources:
        mem_mb=1000
    conda:
        'envs/msg_py3.yml'
    shell:
        'python {SCRIPTS_DIR}/sort_indivs.py'
            ' --input {input.pheno}'
            ' --output {output.sorted}'
            ' > {log} 2>&1'

rule pt_sort_par:
