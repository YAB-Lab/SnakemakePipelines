## Final expected output(s)
rule all:
    input:
        expand(join(OUT_DIR, 'MultiQC', '{genome}','multiqc_report.html'), genome = config['genomes']),
        expand(join(OUT_DIR, 'VCF', 'BWA_GATK', '{genome}', 'all_sites', 'allsites.vcf.gz'), genome = config['genomes'])

