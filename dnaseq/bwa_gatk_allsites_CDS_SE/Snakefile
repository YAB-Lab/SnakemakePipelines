rule GATK_allSites_calls:
    input:
        bam = join(SCRATCH, 'BWA', '{genome}', '{sample}', '{sample}.csorted.bwa.bam'),
        bai = join(SCRATCH, 'BWA', '{genome}', '{sample}', '{sample}.csorted.bwa.bam.bai'),
        dna = lambda wildcards: config['genomes'][wildcards.genome]['fasta']
    output:
        vcf = temp(join(SCRATCH, 'VCF', 'BWA_GATK', '{genome}', 'all_sites', '{sample}', '{sample}.vcf'))
    log:
        join(OUT_DIR, 'Logs', 'VCF', '{genome}', '{sample}.GATK_calls.log')
    benchmark:
        join(OUT_DIR, 'Benchmarks', 'VCF', '{genome}', '{sample}.GATK_calls.benchmark.tsv')
    message:
        """--- Calling all sites with GATK for sample {wildcards.sample} mapped to {wildcards.genome}."""
    threads:
        8
    resources:
        mem_mb=32000
    conda:
        'envs/DaGRP.yml'
    shell:
        'gatk HaplotypeCaller'
            ' -R {input.dna}'
            ' -I {input.bam}'
            ' -O ' + join(SCRATCH, 'VCF', 'BWA_GATK', '{wildcards.genome}','all_sites', '{wildcards.sample}', '{wildcards.sample}.vcf') +
            ' -ERC GVCF'
            ' > {log} 2>&1'

